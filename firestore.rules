rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /scans/{id} {
      allow get: if true;
      // PC画面での一覧購読のため、認証なしでも1回のクエリ最大300件までは許可
      allow list: if request.query.limit != null && request.query.limit <= 300;

      allow create: if request.resource.data.keys().hasOnly(['scannedAt', 'rawText'])
                    && request.resource.data.scannedAt == request.time
                    && request.resource.data.rawText is string
                    && request.resource.data.rawText.size() <= 2000;

      allow update: if false;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
